// Rules v1.1. A rule occupies exactly one physical line and starts with its ID.
// Symbols are explained in python.glossary; its grammar is glossary.tx.
// IMPORTANT: instantiate textX with skipws=False; newlines are significant.
Model:
    lines*=Line
;

Line:
    Section | Policy | Remark | Blank
;

Section:
    H '[' name=Name ']' H EOL
;

Policy:
    H id=ID WS operator=Operator WS target=Name
    (WS 'OVER' WS alternative=Name)?
    (WS 'WHEN' WS when=Condition)?
    (WS 'UNLESS' WS unless=Condition)?
    H EOL
;

Condition:
    first=Name rest*=ConditionTail
;

ConditionTail:
    WS logic=Logic WS value=Name
;

Operator:
    'USE' | 'PREFER' | 'AVOID' | 'FORBID'
;

Logic:
    'AND' | 'OR'
;

ID:
    /[A-Z]{2}[0-9]{4}/
;

Name:
    /[A-Za-z_][A-Za-z0-9_.]*/
;

Remark:
    H '#' /[^\r\n]*/ EOL
;

Blank:
    H EOL
;

H: /[ \t]*/;
WS: /[ \t]+/;
EOL: /\r?\n/;
